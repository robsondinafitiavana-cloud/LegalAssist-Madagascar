<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================
    POM.XML - Fichier de configuration Maven
    ============================================================
    Ce fichier décrit le projet et toutes les "dépendances"
    (bibliothèques externes) dont notre application a besoin.

    Quand tu ouvres ce projet dans NetBeans ou IntelliJ, Maven
    va automatiquement télécharger ces bibliothèques depuis
    Internet la PREMIERE fois (il faut donc une connexion
    Internet uniquement pour la phase d'installation/compilation,
    pas pour l'utilisation finale du logiciel).
    ============================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.legalassist</groupId>
    <artifactId>LegalAssistAI</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>LegalAssist Madagascar AI Offline</name>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
    </properties>

    <dependencies>

        <!-- ========== JAVAFX : pour l'interface graphique ========== -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ========== POSTGRESQL : pilote JDBC pour la base de données ========== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- ========== PDFBOX : pour générer les rapports PDF ========== -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.30</version>
        </dependency>

        <!-- ========== BCRYPT : pour hacher les mots de passe (sécurité) ========== -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Plugin qui permet de lancer une application JavaFX avec "mvn javafx:run" -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.legalassist.Main</mainClass>
                </configuration>
            </plugin>

            <!-- Plugin de compilation Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
