<?xml version="1.0" encoding="UTF-8"?>

<!-- GESTION DES LOIS (loi.fxml) - relie a LoiController.java -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="page" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.legalassist.controller.LoiController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion des lois" styleClass="titre-principal"/>

    <!-- Formulaire d'ajout d'une loi -->
    <VBox spacing="8" styleClass="carte-formulaire">
        <Label text="Ajouter une nouvelle loi" styleClass="label-stat-titre"/>

        <HBox spacing="10">
            <TextField fx:id="champNomLoi" promptText="Nom de la loi" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="comboDomaine" promptText="Domaine juridique"/>
            <DatePicker fx:id="champDatePublication" promptText="Date de publication"/>
        </HBox>
        <TextField fx:id="champSource" promptText="Source (ex: Journal Officiel de Madagascar)"/>

        <Button text="Ajouter la loi" onAction="#ajouterLoi" styleClass="bouton-principal"/>
        <Label fx:id="labelMessageLoi" styleClass="label-message"/>
    </VBox>

    <!-- Formulaire d'ajout d'un article -->
    <VBox spacing="8" styleClass="carte-formulaire">
        <Label text="Ajouter un article à une loi" styleClass="label-stat-titre"/>

        <HBox spacing="10">
            <ComboBox fx:id="comboLoiPourArticle" promptText="Choisir la loi" HBox.hgrow="ALWAYS"/>
            <TextField fx:id="champNumeroArticle" promptText="Numéro (ex: Art. 12)"/>
        </HBox>

        <TextArea fx:id="champContenuArticle" promptText="Contenu de l'article" prefRowCount="3"/>
        <TextField fx:id="champMotsCles" promptText="Mots-clés séparés par des virgules (ex: terrain,propriete,litige)"/>

        <Button text="Ajouter l'article" onAction="#ajouterArticle" styleClass="bouton-principal"/>
        <Label fx:id="labelMessageArticle" styleClass="label-message"/>
    </VBox>

    <!-- Import automatique depuis un PDF -->
    <VBox spacing="8" styleClass="carte-formulaire">
        <Label text="Importer automatiquement les articles depuis un PDF" styleClass="label-stat-titre"/>
        <Label text="L'IA détecte automatiquement les articles (Article X / Art. X) et propose des mots-clés. Vérifie ensuite le résultat, il peut nécessiter des corrections manuelles."
               wrapText="true" styleClass="sous-titre"/>

        <HBox spacing="10">
            <ComboBox fx:id="comboLoiPourImportPDF" promptText="Choisir la loi cible" HBox.hgrow="ALWAYS"/>
            <Button text="Importer un PDF" onAction="#importerPDF" styleClass="bouton-principal"/>
        </HBox>

        <Label fx:id="labelMessageImportPDF" styleClass="label-message" wrapText="true"/>
    </VBox>

    <!-- Tableau des lois -->
    <Label text="Lois enregistrées :" styleClass="label-stat-titre"/>
    <TableView fx:id="tableLois" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNomLoi" text="Nom" prefWidth="280"/>
            <TableColumn fx:id="colDomaine" text="Domaine" prefWidth="180"/>
            <TableColumn fx:id="colSource" text="Source" prefWidth="220"/>
        </columns>
    </TableView>

</VBox>
