<?xml version="1.0" encoding="UTF-8"?>

<!--
    ============================================================
    MAIN_LAYOUT (main_layout.fxml)
    ============================================================
    C'est le nouveau "cadre" de l'application, affiché juste
    après la connexion. Il ne change plus jamais lui-même :
    - à gauche : la sidebar (barre de navigation fixe)
    - à droite : une zone de contenu (StackPane) dans laquelle
      on charge dynamiquement chaque écran (dossiers, lois...)
      sans recharger toute la fenêtre.

    Relié à MainLayoutController.java.
    ============================================================
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.legalassist.controller.MainLayoutController">

    <!-- ===================== SIDEBAR ===================== -->
    <VBox styleClass="sidebar" prefWidth="230" minWidth="230">

        <VBox styleClass="sidebar-entete">
            <Label text="⚖" styleClass="sidebar-logo"/>
            <Label text="LegalAssist" styleClass="sidebar-titre"/>
            <Label text="Madagascar AI" styleClass="sidebar-sous-titre"/>
        </VBox>

        <VBox styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
            <Button fx:id="boutonDashboard" text="🏠  Tableau de bord" onAction="#ouvrirDashboard" styleClass="nav-bouton"/>
            <Button fx:id="boutonDossiers" text="📁  Dossiers" onAction="#ouvrirDossiers" styleClass="nav-bouton"/>
            <Button fx:id="boutonLois" text="📖  Lois" onAction="#ouvrirLois" styleClass="nav-bouton"/>
            <Button fx:id="boutonAudiences" text="🗓  Audiences" onAction="#ouvrirAudiences" styleClass="nav-bouton"/>
            <Button fx:id="boutonAssistantIA" text="🤖  Assistant IA" onAction="#ouvrirAssistantIA" styleClass="nav-bouton"/>
            <Button fx:id="boutonEntrainementIA" text="🎯  Entraînement IA" onAction="#ouvrirEntrainementIA" styleClass="nav-bouton"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-utilisateur">
                <Label fx:id="labelUtilisateurConnecte" styleClass="sidebar-utilisateur-nom" wrapText="true"/>
                <Button text="Se déconnecter" onAction="#seDeconnecter" styleClass="nav-bouton-deconnexion"/>
            </VBox>
        </VBox>

    </VBox>

    <!-- ===================== ZONE DE CONTENU ===================== -->
    <StackPane fx:id="zoneContenu" styleClass="zone-contenu" HBox.hgrow="ALWAYS"/>

</HBox>
